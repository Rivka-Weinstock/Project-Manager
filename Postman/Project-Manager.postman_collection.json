								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id\": 0,\n  \"name\": \"\",\n  \"email\": \"invalid@example.com\"\n}"
						},
						"url": "{{baseUrl}}/api/users",
						"description": "Sends a create request with an empty name.\n\n**Expected:** 400 Bad Request"
					}
				},
				{
					"name": "400 - Route/Body ID Mismatch",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id\": 99,\n  \"name\": \"Mismatch Test\",\n  \"email\": \"test@example.com\"\n}"
						},
						"url": "{{baseUrl}}/api/users/1",
						"description": "Route id (1) does not match body id (99).\n\n**Expected:** 400 Bad Request"
					}
				},
				{
					"name": "400 - DB Constraint (Delete User with Projects)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));",
									"pm.test('Error response has message', () => {",
									"    const body = pm.response.json();",
									"    pm.expect(body).to.have.property('message');",
									"    pm.expect(body).to.have.property('statusCode', 400);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [],
						"url": "{{baseUrl}}/api/users/{{userId}}",
